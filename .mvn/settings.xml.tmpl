<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
                      http://maven.apache.org/xsd/settings-1.0.0.xsd">

    <activeProfiles>
        <activeProfile>github</activeProfile>
    </activeProfiles>

    <profiles>
        <profile>
            <id>github</id>
            <repositories>
                <repository>
                    <id>central</id>
                    <url>https://repo1.maven.org/maven2</url>
                </repository>
                <repository>
                    <id>xjc-kafka-connect-plugin</id>
                    <url>https://maven.pkg.github.com/deepshore/xjc-kafka-connect-plugin</url>
                </repository>
                <repository>
                    <id>github</id>
                    <url>https://maven.pkg.github.com/GH_REPO</url>
                    <snapshots>
                        <enabled>true</enabled>
                    </snapshots>
                </repository>
            </repositories>
        </profile>
    </profiles>

    <servers>
        <server>
            <id>github</id>
            <username>GH_DEPLOY_USERNAME</username>
            <password>GH_DEPLOY_TOKEN</password>
        </server>
        <server>
            <id>xjc-kafka-connect-plugin</id>
            <username>GH_DEPLOY_USERNAME</username>
            <password>GH_DEPLOY_TOKEN</password>
        </server>
        <server>
            <id>central-sonatype</id>
            <username>CENTRAL_DEPLOY_USERNAME</username>
            <password>CENTRAL_DEPLOY_TOKEN</password>
        </server>
    </servers>
</settings>